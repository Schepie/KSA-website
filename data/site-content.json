  "desktop": {
    "texts": {
      "div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "KSA LIMBURG",
      "div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(2)": "Aangesloten bij <strong>KSA Nationaal</strong> • <a href=\"https://www.ksa.be\" target=\"_blank\" rel=\"noopener\">www.ksa.be</a>",
      "div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > span:nth-of-type(1)": "",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "💙❤️ Dé Jeugdbeweging van Zonhoven",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > h1:nth-of-type(1)": "\n            VOOR ALLE TOFFE MEISJES VAN <span class=\"text-blue\">6 TOT 17 JAAR</span>!\n          ",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "\n            Iedere zondagnamiddag van <strong>13u30 tot 17u00</strong> komen wij samen aan ons lokaal (Dijkbeemdenweg 8). \n            Pleinspelen, bosspelen, sfeer, vriendschap voor het leven en een onvergetelijk 10-daags zomerkamp!\n          ",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > span:nth-of-type(1)": "5",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > span:nth-of-type(2)": "Leeftijdsgroepen",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(2) > span:nth-of-type(1)": "100+",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(2) > span:nth-of-type(2)": "Enthousiaste Meisjes",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3) > span:nth-of-type(1)": "10 DAGEN",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(3) > span:nth-of-type(2)": "Groot Zomerkamp",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4) > span:nth-of-type(1)": "13U30",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(4) > span:nth-of-type(2)": "Elke Zondag",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > div:nth-of-type(2) > div:nth-of-type(1)": "KSA ZONHOVEN MEISJES",
      "#mainContent > section:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > div:nth-of-type(2) > div:nth-of-type(2)": "Elke zondag van 13u30 tot 17u00",
      "#mainContent > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "🔥 GROOT KSA ZONHOVEN EVENEMENT",
      "#mainContent > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": "HALLOKIEN BINGO NIGHT 2026 🎃",
      "#mainContent > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "Zaterdag 17 oktober • Polyvalente Zaal Evenementenhal Zonhoven • Vol = Vol!",
      "#nieuws > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "Wat gebeurt er bij KSA Zonhoven?",
      "#nieuws > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": "NIEUWS &amp; EVENEMENTEN",
      "#nieuws > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "\n            Blijf op de hoogte van onze activiteiten, inschrijvingen, kienavond en spaghettidag!\n          ",
      "#groepen > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "Onze Leeftijdsgroepen",
      "#groepen > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": "WELKE GROEP HOOR JIJ BIJ?",
      "#groepen > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "\n            KSA Zonhoven telt 5 enthousiaste leeftijdsgroepen en de leiding (+16). Klik op jouw groep of leeftijd en ontdek wat jouw bende doet!\n          ",
      "#agenda > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "Werkjaarplanning",
      "#agenda > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": "OFFICIËLE KALENDER",
      "#agenda > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "\n            Bekijk hieronder de officiële kalender van KSA Zonhoven Meisjes voor het werkjaar.\n          ",
      "#cal-poster-sub": "SEPT – JULI",
      "#info > div:nth-of-type(1) > div:nth-of-type(1) > span:nth-of-type(1)": "Praktische Informatie",
      "#info > div:nth-of-type(1) > div:nth-of-type(1) > h2:nth-of-type(1)": "UNIFORM &amp; WERKING",
      "#info > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "\n            Alles wat je als lid of ouder moet weten over het zondagprogramma en ons KSA-uniform.\n          ",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > div:nth-of-type(1)": "⏰",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > h3:nth-of-type(1)": "WEKELIJKSE ZONDAGEN",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1) > p:nth-of-type(1)": "\n              Wij meisjes van KSA Zonhoven komen iedere zondag van <strong>13u30 tot 17u00</strong> samen. Pleinspelen, bosspel, tocht, knutselen... je kan het zo gek niet bedenken of wij doen het!\n            ",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > div:nth-of-type(1)": "👕",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > h3:nth-of-type(1)": "ONS KSA UNIFORM",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(2) > p:nth-of-type(1)": "\n              Elke zondag dragen we hetzelfde! Een donkerblauwe trui of hemd en ons KSA sjaaltje. We dragen het met trots overal naartoe en op de Dag van de Jeugdbeweging kleuren we alle straten blauw!\n            ",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > div:nth-of-type(1)": "🏕️",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > h3:nth-of-type(1)": "WEEKEND &amp; KAMP",
      "#info > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > p:nth-of-type(1)": "\n              Buiten de wekelijkse activiteiten gaan we 1 keer per jaar op weekend én op ons grote 10-daags zomerkamp. Ook doen we mee aan initiatieven van KSA Limburg en KSA Nationaal!\n            ",
      "#info > div:nth-of-type(1) > div:nth-of-type(3) > span:nth-of-type(1)": "📝 Inschrijven via RAVOT (ksa.be)",
      "#info > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(1) > div:nth-of-type(1)": "1",
      "#info > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(1) > h5:nth-of-type(1)": "Surf naar Ravot",
      "#info > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(1) > p:nth-of-type(1)": "Ga naar <a href=\"https://ravot.ksa.be\" target=\"_blank\" rel=\"noopener\" style=\"color:var(--ksa-yellow); text-decoration:underline;\">ravot.ksa.be</a> op je pc of smartphone.",
      "#info > div:nth-of-type(1) > div:nth-of-type(3) > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(1)": "2",
