      "#leiding > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > h3:nth-of-type(1)": "SLOEBERS",
      "#leiding > div:nth-of-type(1) > div:nth-of-type(2) > div:nth-of-type(3) > span:nth-of-type(1)": "Lien &amp; Lies (8-10j)",
